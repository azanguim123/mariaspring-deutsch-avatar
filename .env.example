APP_ENV=development
DEFAULT_LEVEL=A1
DATA_DIR=data
ASSETS_DIR=assets

# LLM (Ollama local)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# STT (faster-whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS (Edge TTS en allemand)
TTS_VOICE_DE=de-DE-KatjaNeural
AUDIO_OUTPUT_DIR=outputs/audio